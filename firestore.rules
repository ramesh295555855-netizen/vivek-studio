rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    // --- Interaction Validation ---
    function isValidInteraction(data) {
      return data.keys().hasAll(['userId', 'prompt', 'response', 'timestamp'])
        && data.userId is string && data.userId.size() <= 128
        && data.prompt is string && data.prompt.size() <= 5000
        && data.response is string && data.response.size() <= 10000;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().uid == userId
                     && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming())
                     && incoming().uid == existing().uid
                     && incoming().createdAt == existing().createdAt
                     && incoming().lastActive == request.time
                     && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastActive', 'email']);

      // 2. Interactions Subcollection
      match /interactions/{interactionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidInteraction(incoming())
                       && incoming().userId == userId
                       && incoming().timestamp == request.time;
        allow delete: if isOwner(userId);
      }
    }
  }
}
